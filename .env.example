# Template — copy to .env.local (dev) / .env.prod (production) and fill in
# real values. Never commit the real files.

# --- Core ---
PORT=3000
# Bind address. Defaults to 127.0.0.1 (not reachable from outside the box) —
# set to 0.0.0.0 only behind a reverse proxy in production.
BIND_HOST=127.0.0.1
NODE_ENV=development
APP_NAME=Tracking API
API_PREFIX=api
# CORS allow-list — comma-separated. Every browser client must be listed: the
# super-admin dashboard AND the public tracking site.
FRONTEND_URL=http://localhost:3000
GRAPHQL_PATH=/graphql
GRAPHQL_INTROSPECTION=true

# --- Database ---
# One Postgres server, a separate database per environment (never share
# dev <-> prod). Set `?connection_limit=N` explicitly rather than relying on
# Prisma's default, and budget it against the server's max_connections.
DATABASE_URL=postgres://user:password@localhost:5432/tracking_dev?connection_limit=10
DB_LOGGING=false

# --- Auth (JWT + cookies) ---
# Generate strong secrets: openssl rand -hex 32
# (production refuses to boot with placeholder secrets)
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-strong-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d
# Domain the auth cookies are scoped to (leave unset for host-only in dev).
COOKIE_DOMAIN=

# --- Rate limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# --- Seed (DatabaseSeedService, runs on boot — silently skipped if unset) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Also seed a sample manager/advertiser/campaign for local development.
SEED_SAMPLE=false

# --- Tracking (click redirect + S2S postback) ---
# HMAC-SHA256 secret the affiliate network signs postback requests with.
POSTBACK_SECRET=replace-with-a-strong-secret
# A click older than this is rejected by the postback handler even with a
# valid signature (default 720h / 30 days if unset).
MAX_CLICK_AGE_HOURS=720

# --- File uploads (campaign/offer icons) ---
UPLOAD_DIR=./uploads

# --- Billing (Stripe) ---
# Required only if the billing module's webhook is enabled — the app
# currently throws at construction time if unset and billing is wired in.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Observability (optional) ---
# Crash reporting is a no-op until this is set — never a hard boot dependency.
SENTRY_DSN=

