generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Identity / RBAC ----

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  STAFF
  AFFILIATE
  ADVERTISER
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  password        String
  firstName       String
  lastName        String
  role            UserRole  @default(AFFILIATE)
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  affiliate     Affiliate?
  advertiser    Advertiser?
  managedAdvertisers Advertiser[] @relation("ManagerToAdvertisers")
  refreshTokens RefreshToken[]
}

// ---- Auth sessions ----

// DB-backed refresh sessions with rotation — see RefreshTokenService.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  family    String
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([family])
}

// ---- Affiliates ----
// Fields below cover the public self-registration form
// (tracking-super-admin-dashboard `/sign-up`). The admin-side "Add Affiliate"
// form has more fields (manager, companyName, commissionRate, payoutMethod,
// status set directly) — those are added in Phase 3 when the full Affiliates
// module is built; this model will grow, not get replaced.

enum BusinessType {
  AFFILIATE
  AGENCY
  ADVERTISER
  NETWORK
  OTHER
}

enum ContactMethod {
  TELEGRAM
  WHATSAPP
  SKYPE
  EMAIL
}

enum CurrentPlatform {
  NONE
  EVERFLOW
  CAKE
  HASOFFERS
  AFFISE
  OTHER
}

enum ReferralSource {
  SEARCH
  SOCIAL
  REFERRAL
  EVENT
  OTHER
}

// Matches the dashboard's AffiliateRowStatus ("active" | "pending" | "inactive" | "suspended").
enum AffiliateStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Affiliate {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @unique @db.Uuid
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessType    BusinessType
  phone           String
  country         String
  contactMethod   ContactMethod?
  currentPlatform CurrentPlatform  @default(NONE)
  referralSource  ReferralSource?
  referralCode    String?          @unique
  status          AffiliateStatus  @default(PENDING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  conversions Conversion[]
  fraudCases  FraudCase[]
  groupMembers AffiliateGroupMember[]
  paymentTerms PaymentTerm[]
  payments AffiliatePayment[]
  referralsSent Referral[] @relation("Referrer")
  referralsReceived Referral[] @relation("Referred")

  @@index([status])
}

model AffiliateGroup {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?  @db.Text
  budget      Decimal? @db.Decimal(12, 4)
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members AffiliateGroupMember[]

  @@index([name])
}

model AffiliateGroupMember {
  id            String        @id @default(uuid()) @db.Uuid
  groupId       String        @db.Uuid
  group         AffiliateGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  affiliateId   String        @db.Uuid
  affiliate     Affiliate     @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  role          String        @default("MEMBER")
  joinedAt      DateTime      @default(now())

  @@unique([groupId, affiliateId])
  @@index([affiliateId])
}

model PaymentTerm {
  id            String   @id @default(uuid()) @db.Uuid
  affiliateId   String   @db.Uuid
  affiliate     Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  minPayout     Decimal  @db.Decimal(10, 2)
  paymentMethod String
  currency      String   @default("USD")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([affiliateId])
  @@index([affiliateId])
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

model AffiliatePayment {
  id            String          @id @default(uuid()) @db.Uuid
  affiliateId   String          @db.Uuid
  affiliate     Affiliate       @relation(fields: [affiliateId], references: [id])
  amount        Decimal         @db.Decimal(10, 2)
  currency      String          @default("USD")
  status        PaymentStatus   @default(PENDING)
  paymentMethod String
  transactionId String?
  paidAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([affiliateId])
  @@index([status])
}

model Referral {
  id            String    @id @default(uuid()) @db.Uuid
  referrerId    String    @db.Uuid
  referrer      Affiliate @relation("Referrer", fields: [referrerId], references: [id])
  referredId    String    @db.Uuid
  referred      Affiliate @relation("Referred", fields: [referredId], references: [id])
  code          String
  createdAt     DateTime  @default(now())

  @@unique([code])
  @@index([referrerId])
  @@index([referredId])
}

// ---- Advertisers (Phase 2) -------

enum AdvertiserStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Advertiser {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @unique @db.Uuid
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName    String
  phone          String
  country        String
  managerId      String?          @db.Uuid
  manager        User?            @relation("ManagerToAdvertisers", fields: [managerId], references: [id])
  contactMethod  ContactMethod?
  contactId      String?
  description    String?
  commissionRate Decimal?         @db.Decimal(5, 2)
  payoutMethod   String?
  referralCode   String?          @unique
  status         AdvertiserStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  campaigns Campaign[]
  offers    Offer[]

  @@index([managerId])
  @@index([status])
}

// ---- Campaigns (Phase 2 — advertiser self-service) ----

enum Currency {
  USD
  EUR
  GBP
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  PAUSED
  EXPIRED
  REJECTED
}

enum CostModel {
  CPA
  CPL
  CPS
  REVSHARE
}

enum PayoutType {
  CPA
  CPL
  CPS
  REVSHARE
  FLAT
}

enum CapType {
  DAILY
  WEEKLY
  MONTHLY
  TOTAL
}

model Campaign {
  id             String         @id @default(uuid()) @db.Uuid
  slug           String         @unique
  advertiserId   String         @db.Uuid
  advertiser     Advertiser     @relation(fields: [advertiserId], references: [id])
  offerId        String?        @db.Uuid
  offer          Offer?         @relation(fields: [offerId], references: [id])
  name           String
  title          String
  description    String?
  kpi            String?
  category       String
  previewLink    String
  trackingLink   String
  partner        String?
  costModel      CostModel      @default(CPA)
  defaultCost    Decimal        @db.Decimal(12, 4)
  currency       Currency       @default(USD)
  startDate      DateTime
  endDate        DateTime
  status         CampaignStatus @default(DRAFT)
  icon           String?
  geo            String[]
  trafficAllowed String[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  payouts CampaignPayout[]
  caps    CampaignCap[]
  remarks CampaignRemark[]
  clicks  Click[]
  conversions Conversion[]

  @@index([advertiserId, status])
  @@index([createdAt])
}

model CampaignPayout {
  id          String     @id @default(uuid()) @db.Uuid
  campaignId  String     @db.Uuid
  campaign    Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  country     String?
  device      String?
  platform    String?
  payoutType  PayoutType
  payoutValue Decimal    @db.Decimal(12, 4)
  currency    Currency   @default(USD)
  createdAt   DateTime   @default(now())

  @@index([campaignId])
}

model CampaignCap {
  id           String    @id @default(uuid()) @db.Uuid
  campaignId   String    @db.Uuid
  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  capType      CapType
  capLimit     Int
  currentCount Int       @default(0)
  resetAt      DateTime?
  createdAt    DateTime  @default(now())

  @@index([campaignId])
}

model CampaignRemark {
  id         String   @id @default(uuid()) @db.Uuid
  campaignId String   @db.Uuid
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  forRole    UserRole
  text       String
  createdAt  DateTime @default(now())

  @@index([campaignId])
}

// ---- Offers (Phase 6 — super-admin created) ----

enum OfferType {
  CPA
  CPL
  CPS
  CPI
}

enum OfferStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  PAUSED
  EXPIRED
}

enum OfferAccess {
  PUBLIC
  PRIVATE
}

model Offer {
  id              String      @id @default(uuid()) @db.Uuid
  advertiserId    String      @db.Uuid
  advertiser      Advertiser  @relation(fields: [advertiserId], references: [id])
  name            String
  slug            String      @unique
  type            OfferType
  category        String
  currency        Currency    @default(USD)
  previewLink     String
  trackingLink    String
  description     String?
  icon            String?
  trafficSources  String[]
  status          OfferStatus @default(PENDING)
  access          OfferAccess @default(PUBLIC)
  networkOfferId  String?     @unique
  startDate       DateTime?
  endDate         DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  payouts OfferPayout[]
  caps    OfferCap[]
  remarks OfferRemark[]
  campaigns Campaign[]
  fraudCases FraudCase[]

  @@index([advertiserId, status])
  @@index([createdAt])
}

model OfferPayout {
  id          String     @id @default(uuid()) @db.Uuid
  offerId     String     @db.Uuid
  offer       Offer      @relation(fields: [offerId], references: [id], onDelete: Cascade)
  country     String?
  device      String?
  platform    String?
  payoutType  PayoutType
  payoutValue Decimal    @db.Decimal(12, 4)
  currency    Currency   @default(USD)
  createdAt   DateTime   @default(now())

  @@index([offerId])
}

model OfferCap {
  id           String    @id @default(uuid()) @db.Uuid
  offerId      String    @db.Uuid
  offer        Offer     @relation(fields: [offerId], references: [id], onDelete: Cascade)
  capType      CapType
  capLimit     Int
  currentCount Int       @default(0)
  resetAt      DateTime?
  createdAt    DateTime  @default(now())

  @@index([offerId])
}

model OfferRemark {
  id         String   @id @default(uuid()) @db.Uuid
  offerId    String   @db.Uuid
  offer      Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  forRole    UserRole
  text       String
  createdAt  DateTime @default(now())

  @@index([offerId])
}

model CrExperiment {
  id            String    @id @default(uuid()) @db.Uuid
  offerId       String    @db.Uuid
  name          String
  description   String?   @db.Text
  status        String    @default("ACTIVE")
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([offerId])
}

// ---- Tracking core (Phase 3) ----

enum ConversionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Click {
  id          String   @id @default(uuid()) @db.Uuid
  campaignId  String?  @db.Uuid
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  /**
   * Public-facing click ID — used by affiliate networks to attribute their
   * postback back to our click. Uniqueness is critical: a duplicate would
   * double-attribute one click to two conversions. UUIDv4 → 1 in 2^122
   * collision risk, negligible.
   */
  clickId     String   @unique
  ip          String
  userAgent   String   @db.Text
  country     String?
  device      String?
  browser     String?
  os          String?
  referrer    String?
  source      String?  // traffic source / utm_source
  isUnique    Boolean  @default(false)
  /**
   * Whether recording this click breached a CampaignCap. The click is
   * still stored (for fraud analysis) but won't generate downstream
   * conversions because `capBlocked` is checked at postback time.
   */
  capBlocked  Boolean  @default(false)
  createdAt   DateTime @default(now())

  conversions Conversion[]

  @@index([campaignId, createdAt])
  @@index([createdAt])
  @@index([ip, campaignId, createdAt])
}

model Conversion {
  id            String           @id @default(uuid()) @db.Uuid
  campaignId    String?          @db.Uuid
  campaign      Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  clickId       String
  click         Click            @relation(fields: [clickId], references: [clickId])
  affiliateId   String?          @db.Uuid
  affiliate     Affiliate?       @relation(fields: [affiliateId], references: [id])
  revenue       Decimal          @db.Decimal(14, 4)
  payout        Decimal          @db.Decimal(14, 4)
  status        ConversionStatus @default(PENDING)
  /**
   * Advertiser-supplied transaction id (txn_id). Always unique — used
   * to dedupe replays of the same postback. Indexed because the hot
   * postback path is "INSERT ... ON CONFLICT DO NOTHING".
   */
  transactionId String           @unique
  goalId        String?
  createdAt     DateTime         @default(now())

  @@index([campaignId, status, createdAt])
  @@index([affiliateId, createdAt])
}

model AffiliatePostbackLog {
  id            String   @id @default(uuid()) @db.Uuid
  affiliateId   String?  @db.Uuid
  transactionId String
  endpointUrl   String   @db.Text
  httpStatus    Int
  attempts      Int      @default(1)
  successful    Boolean
  payload       Json?
  createdAt     DateTime @default(now())

  @@index([transactionId])
  @@index([createdAt])
}

model AdvertiserPostbackLog {
  id            String   @id @default(uuid()) @db.Uuid
  advertiserId  String?  @db.Uuid
  transactionId String
  endpointUrl   String   @db.Text
  httpStatus    Int
  attempts      Int      @default(1)
  successful    Boolean
  payload       Json?
  createdAt     DateTime @default(now())

  @@index([transactionId])
  @@index([createdAt])
}

model FraudCase {
  id            String          @id @default(uuid()) @db.Uuid
  affiliateId   String?         @db.Uuid
  affiliate     Affiliate?      @relation(fields: [affiliateId], references: [id])
  offerId       String?         @db.Uuid
  offer         Offer?        @relation(fields: [offerId], references: [id])
  reason        String
  flaggedClicks Int             @default(0)
  fraudPercent  Decimal         @db.Decimal(5, 2)
  risk          FraudRiskLevel
  status        FraudCaseStatus @default(OPEN)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([affiliateId])
  @@index([offerId])
  @@index([status])
}

enum FraudRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum FraudCaseStatus {
  OPEN
  BLOCKED
  CLEARED
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  message   String   @db.Text
  type      String   @default("info")
  broadcast Boolean @default(false)
  createdAt DateTime @default(now())
  reads     NotificationRead[]

  @@index([createdAt])
}

model NotificationRead {
  id            String    @id @default(uuid()) @db.Uuid
  notificationId String   @db.Uuid
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId        String    @db.Uuid
  readAt        DateTime?

  @@unique([notificationId, userId])
  @@index([userId])
}

model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

enum PlanInterval {
  MONTH
  YEAR
}

model Plan {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  description String?       @db.Text
  price       Decimal       @db.Decimal(10, 2)
  interval    PlanInterval  @default(MONTH)
  stripePriceId String?     @unique
  features    Json
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
}

model Subscription {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @db.Uuid
  planId             String              @db.Uuid
  plan               Plan                @relation(fields: [planId], references: [id])
  status             SubscriptionStatus  @default(INCOMPLETE)
  stripeSubscriptionId String?           @unique
  stripeCustomerId   String?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean             @default(false)
  canceledAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([userId])
  @@index([stripeSubscriptionId])
}

enum PaymentMethodType {
  CARD
  SEPA_DEBIT
  US_BANK_ACCOUNT
}

model PaymentMethod {
  id                  String             @id @default(uuid()) @db.Uuid
  userId              String             @db.Uuid
  type                PaymentMethodType
  stripePaymentMethodId String           @unique
  isDefault           Boolean            @default(false)
  last4               String?
  brand               String?
  expiryMonth         Int?
  expiryYear          Int?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([userId])
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

model Invoice {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @db.Uuid
  subscriptionId    String?          @db.Uuid
  stripeInvoiceId   String?          @unique
  number            String?
  status            InvoiceStatus    @default(DRAFT)
  amountDue         Decimal          @db.Decimal(10, 2)
  amountPaid        Decimal          @db.Decimal(10, 2)
  currency          String           @default("USD")
  invoicePdf        String?
  hostedInvoiceUrl  String?
  dueDate           DateTime?
  paidAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([userId])
  @@index([stripeInvoiceId])
}

model Faq {
  id          String   @id @default(uuid()) @db.Uuid
  question    String   @db.Text
  answer      String   @db.Text
  category    String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([sortOrder])
}

model SignupQuestion {
  id          String   @id @default(uuid()) @db.Uuid
  label       String   @db.Text
  type        String   @default("text")
  options     Json?
  required    Boolean  @default(false)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

model LoginLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  ip        String
  userAgent String?
  success   Boolean
  failureReason String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model SupportTicket {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @db.Uuid
  subject     String
  description String             @db.Text
  priority    TicketPriority     @default(MEDIUM)
  status      TicketStatus       @default(OPEN)
  assigneeId  String?
  resolvedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([userId])
  @@index([status])
  @@index([priority])
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model RolePermission {
  id         String   @id @default(uuid()) @db.Uuid
  role       UserRole
  permission String
  createdAt  DateTime @default(now())

  @@unique([role, permission])
  @@index([role])
}
