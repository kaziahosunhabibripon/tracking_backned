generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Identity / RBAC ----

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  STAFF
  AFFILIATE
  ADVERTISER
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  password        String
  firstName       String
  lastName        String
  role            UserRole  @default(AFFILIATE)
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  affiliate     Affiliate?
  advertiser    Advertiser?
  managedAdvertisers Advertiser[] @relation("ManagerToAdvertisers")
  refreshTokens RefreshToken[]
}

// ---- Auth sessions ----

// DB-backed refresh sessions with rotation — see RefreshTokenService.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  family    String
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([family])
}

// ---- Affiliates ----
// Fields below cover the public self-registration form
// (tracking-super-admin-dashboard `/sign-up`). The admin-side "Add Affiliate"
// form has more fields (manager, companyName, commissionRate, payoutMethod,
// status set directly) — those are added in Phase 3 when the full Affiliates
// module is built; this model will grow, not get replaced.

enum BusinessType {
  AFFILIATE
  AGENCY
  ADVERTISER
  NETWORK
  OTHER
}

enum ContactMethod {
  TELEGRAM
  WHATSAPP
  SKYPE
  EMAIL
}

enum CurrentPlatform {
  NONE
  EVERFLOW
  CAKE
  HASOFFERS
  AFFISE
  OTHER
}

enum ReferralSource {
  SEARCH
  SOCIAL
  REFERRAL
  EVENT
  OTHER
}

// Matches the dashboard's AffiliateRowStatus ("active" | "pending" | "inactive" | "suspended").
enum AffiliateStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Affiliate {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @unique @db.Uuid
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessType    BusinessType
  phone           String
  country         String
  contactMethod   ContactMethod?
  currentPlatform CurrentPlatform  @default(NONE)
  referralSource  ReferralSource?
  status          AffiliateStatus  @default(PENDING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  conversions Conversion[]
}

// ---- Advertisers (Phase 2) ----

enum AdvertiserStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Advertiser {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @unique @db.Uuid
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName    String
  phone          String
  country        String
  managerId      String?          @db.Uuid
  manager        User?            @relation("ManagerToAdvertisers", fields: [managerId], references: [id])
  contactMethod  ContactMethod?
  contactId      String?
  description    String?
  commissionRate Decimal?         @db.Decimal(5, 2)
  payoutMethod   String?
  referralCode   String?          @unique
  status         AdvertiserStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  campaigns Campaign[]

  @@index([managerId])
  @@index([status])
}

// ---- Campaigns (Phase 2 — advertiser self-service) ----

enum Currency {
  USD
  EUR
  GBP
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  PAUSED
  EXPIRED
  REJECTED
}

enum CostModel {
  CPA
  CPL
  CPS
  REVSHARE
}

enum PayoutType {
  CPA
  CPL
  CPS
  REVSHARE
  FLAT
}

enum CapType {
  DAILY
  WEEKLY
  MONTHLY
  TOTAL
}

model Campaign {
  id             String         @id @default(uuid()) @db.Uuid
  slug           String         @unique
  advertiserId   String         @db.Uuid
  advertiser     Advertiser     @relation(fields: [advertiserId], references: [id])
  name           String
  title          String
  description    String?
  kpi            String?
  category       String
  previewLink    String
  trackingLink   String
  partner        String?
  costModel      CostModel      @default(CPA)
  defaultCost    Decimal        @db.Decimal(12, 4)
  currency       Currency       @default(USD)
  startDate      DateTime
  endDate        DateTime
  status         CampaignStatus @default(DRAFT)
  icon           String?
  geo            String[]
  trafficAllowed String[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  payouts CampaignPayout[]
  caps    CampaignCap[]
  remarks CampaignRemark[]
  clicks  Click[]
  conversions Conversion[]

  @@index([advertiserId, status])
  @@index([createdAt])
}

model CampaignPayout {
  id          String     @id @default(uuid()) @db.Uuid
  campaignId  String     @db.Uuid
  campaign    Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  country     String?
  device      String?
  platform    String?
  payoutType  PayoutType
  payoutValue Decimal    @db.Decimal(12, 4)
  currency    Currency   @default(USD)
  createdAt   DateTime   @default(now())

  @@index([campaignId])
}

model CampaignCap {
  id           String    @id @default(uuid()) @db.Uuid
  campaignId   String    @db.Uuid
  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  capType      CapType
  capLimit     Int
  currentCount Int       @default(0)
  resetAt      DateTime?
  createdAt    DateTime  @default(now())

  @@index([campaignId])
}

model CampaignRemark {
  id         String   @id @default(uuid()) @db.Uuid
  campaignId String   @db.Uuid
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  forRole    UserRole
  text       String
  createdAt  DateTime @default(now())

  @@index([campaignId])
}

// ---- Tracking core (Phase 3) ----

enum ConversionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Click {
  id          String   @id @default(uuid()) @db.Uuid
  campaignId  String?  @db.Uuid
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  /**
   * Public-facing click ID — used by affiliate networks to attribute their
   * postback back to our click. Uniqueness is critical: a duplicate would
   * double-attribute one click to two conversions. UUIDv4 → 1 in 2^122
   * collision risk, negligible.
   */
  clickId     String   @unique
  ip          String
  userAgent   String   @db.Text
  country     String?
  device      String?
  browser     String?
  os          String?
  referrer    String?
  source      String?  // traffic source / utm_source
  isUnique    Boolean  @default(false)
  /**
   * Whether recording this click breached a CampaignCap. The click is
   * still stored (for fraud analysis) but won't generate downstream
   * conversions because `capBlocked` is checked at postback time.
   */
  capBlocked  Boolean  @default(false)
  createdAt   DateTime @default(now())

  conversions Conversion[]

  @@index([campaignId, createdAt])
  @@index([createdAt])
  @@index([ip, campaignId, createdAt])
}

model Conversion {
  id            String           @id @default(uuid()) @db.Uuid
  campaignId    String?          @db.Uuid
  campaign      Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  clickId       String
  click         Click            @relation(fields: [clickId], references: [clickId])
  affiliateId   String?          @db.Uuid
  affiliate     Affiliate?       @relation(fields: [affiliateId], references: [id])
  revenue       Decimal          @db.Decimal(14, 4)
  payout        Decimal          @db.Decimal(14, 4)
  status        ConversionStatus @default(PENDING)
  /**
   * Advertiser-supplied transaction id (txn_id). Always unique — used
   * to dedupe replays of the same postback. Indexed because the hot
   * postback path is "INSERT ... ON CONFLICT DO NOTHING".
   */
  transactionId String           @unique
  goalId        String?
  createdAt     DateTime         @default(now())

  @@index([campaignId, status, createdAt])
  @@index([affiliateId, createdAt])
}

model AffiliatePostbackLog {
  id            String   @id @default(uuid()) @db.Uuid
  affiliateId   String?  @db.Uuid
  transactionId String
  endpointUrl   String   @db.Text
  httpStatus    Int
  attempts      Int      @default(1)
  successful    Boolean
  payload       Json?
  createdAt     DateTime @default(now())

  @@index([transactionId])
  @@index([createdAt])
}

model AdvertiserPostbackLog {
  id            String   @id @default(uuid()) @db.Uuid
  advertiserId  String?  @db.Uuid
  transactionId String
  endpointUrl   String   @db.Text
  httpStatus    Int
  attempts      Int      @default(1)
  successful    Boolean
  payload       Json?
  createdAt     DateTime @default(now())

  @@index([transactionId])
  @@index([createdAt])
}
